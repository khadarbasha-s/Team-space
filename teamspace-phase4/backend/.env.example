# Copy this file to backend/.env and fill in real values. backend/.env is
# loaded automatically (see app/config.py's load_dotenv() call) and is
# git-ignored -- never commit real secrets here.

# SMTP (optional): meeting invites, RSVP notices, and reminder emails only
# send if SMTP_HOST and SMTP_FROM_ADDRESS are both set. Leave unset to keep
# running with in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# How long before an event's start time its reminder fires, and how often
# the background loop checks for events crossing that threshold.
REMINDER_MINUTES_BEFORE=15
REMINDER_POLL_SECONDS=60

# Billing (subscriptions). With no RAZORPAY_* keys the app uses a fake
# "sandbox" checkout that only works when ENVIRONMENT=development. For real
# payments create a Razorpay account, then set all three:
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET  -- Dashboard > Account & Settings > API keys
#   RAZORPAY_WEBHOOK_SECRET                -- Dashboard > Webhooks; add
#     https://<your-api-host>/billing/webhook/razorpay with events
#     payment.captured and order.paid
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# BILLING_CURRENCY=USD        # must be a currency your Razorpay account accepts
# PRICE_PER_SEAT_CENTS=800    # per active member per period
# BILLING_PERIOD_DAYS=30
# TRIAL_DAYS=14
# BILLING_GRACE_DAYS=3        # days past the paid period before auto-suspend
