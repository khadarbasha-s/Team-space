
# Outbound email (Gmail SMTP) -- used for member invites and welcome mails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=learn@rooman.com
SMTP_PASSWORD=gqqxojzxnjchxbul
SMTP_FROM_ADDRESS=learn@rooman.com
SMTP_USE_TLS=true
# Public URL of the frontend, used to build links inside emails.
FRONTEND_URL=http://localhost:5173

# Local dev database (the teamspace-pg Docker container).
DATABASE_URL=postgresql+psycopg2://teamspace:teamspace_dev_pw@localhost:5434/teamspace

# Server-side meeting recording (LiveKit Egress via docker-compose.media.yml).
EGRESS_ENABLED=true
