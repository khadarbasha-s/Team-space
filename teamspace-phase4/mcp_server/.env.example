# Settings for the REMOTE (HTTP) MCP server. Copy to .env and fill in.
# Never commit a real .env.

# Public https URL where ChatGPT will reach this server (no trailing slash).
MCP_PUBLIC_URL=https://mcp.example.com

# URL of the TeamSpace backend, as reachable FROM this server.
TEAMSPACE_URL=https://api.example.com

# Optional:
# MCP_PORT=8080
# MCP_DB_PATH=/data/mcp_oauth.db
# MCP_ALLOWED_REDIRECT_HOSTS=chatgpt.com,openai.com,claude.ai,claude.com,localhost
# MCP_ALLOWED_HOSTS=            # extra Host headers to accept (e.g. an internal LB name)
# TEAMSPACE_WS_URL=wss://api.example.com   # only if the websocket URL differs from TEAMSPACE_URL
# TEAMSPACE_TZ=Asia/Kolkata
